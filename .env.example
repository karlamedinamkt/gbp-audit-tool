# Copy this file to .env (for local dev with `vercel dev`) or set these
# as Environment Variables in your Vercel project settings.

# Google Cloud project with "Places API (New)" enabled + billing.
# Note: reviews/photos fields require the Atmosphere SKU (small per-request cost).
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Anthropic API key — used to generate the audit report.
# Get one at https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: send each lead's info to a webhook (Zapier, Make, Google Sheets, etc.)
LEAD_WEBHOOK_URL=
